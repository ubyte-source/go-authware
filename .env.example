# ── go-authware ConfigFromEnv ─────────────────────────────────
# Every variable ConfigFromEnv("") reads; a non-empty prefix argument is
# prepended to each name. Only AUTH_MODE is always required;
# each mode reads its own section, and a setting in the section of
# another mode is refused. Lists are comma-separated, except
# AUTH_MTLS_ALLOWED_SUBJECTS, which is semicolon-separated because
# distinguished names hold commas; a backslash keeps the byte after it,
# and itself, in the element, and no element may end in a lone backslash.
# Durations use Go syntax (30s, 5m). Booleans use strconv.ParseBool.

# ── Mode ─────────────────────────────────────────────────────
# none | bearer | apikey | oauth | mtls
AUTH_MODE=oauth

# Realm advertised in WWW-Authenticate (default: restricted).
# AUTH_REALM=restricted

# ── Bearer token (AUTH_MODE=bearer) ──────────────────────────
# Shared token, at least 32 bytes, without control bytes, spaces or tabs.
# AUTH_BEARER_TOKEN=replace-with-a-random-token-of-32-bytes-or-more

# ── API key (AUTH_MODE=apikey) ───────────────────────────────
# Shared key, at least 32 bytes that start and end with a visible character
# and hold no control byte but inner tabs.
# AUTH_APIKEY=replace-with-a-random-key-of-32-bytes-or-more
# Header carrying the key (default: X-Api-Key); Authorization: ApiKey <key>
# is accepted when the header is absent and the key has no space or tab.
# AUTH_APIKEY_HEADER=X-Api-Key

# ── OAuth / JWT (AUTH_MODE=oauth) ────────────────────────────
# Required. The issuer must equal the token iss claim byte for byte, and
# the audience must appear in its aud claim.
AUTH_OAUTH_ISSUER=https://login.example.com/tenant
AUTH_OAUTH_AUDIENCE=api://my-api

# Signing keys. With neither variable the JWKS is discovered from the
# issuer, and its jwks_uri must be on the issuer origin. The two are
# exclusive; the HMAC secret needs at least 32 bytes, and 48 or 64 bytes
# to verify HS384 or HS512.
# AUTH_OAUTH_JWKS_URL=https://login.example.com/tenant/keys
# AUTH_OAUTH_HMAC_SECRET=replace-with-a-random-secret-of-32-bytes-or-more

# Scopes every token must grant.
# AUTH_OAUTH_REQUIRED_SCOPES=orders.read,orders.write

# Accept only tokens typed at+jwt.
# AUTH_OAUTH_REQUIRE_AT_JWT=false

# Tolerance on exp, nbf and iat (default 30s), lifetime of the cached keys
# and issuer metadata (default 5m), and the bound on JWKS, discovery and
# facade fetches (default 10s).
# AUTH_OAUTH_CLOCK_SKEW=30s
# AUTH_OAUTH_KEYS_CACHE_TTL=5m
# AUTH_OAUTH_FETCH_TIMEOUT=10s

# External origin (scheme://host[:port], lower case, without the default
# port) used in metadata and challenges; without it the origin comes from
# the request.
# AUTH_OAUTH_PUBLIC_URL=https://api.example.com
# Take the scheme from X-Forwarded-Proto; set only behind a proxy that
# overwrites it.
# AUTH_OAUTH_TRUST_FORWARDED_PROTO=false

# Protected resource metadata. The identifier defaults to the origin plus
# the escaped request path after /.well-known/oauth-protected-resource, or
# for that bare path the first endpoint unless it is /; the authorization
# servers default to a secure-URL issuer and must stay unset when the
# facade is enabled.
# AUTH_OAUTH_RESOURCE=https://api.example.com/mcp
# AUTH_OAUTH_RESOURCE_NAME=My API
# AUTH_OAUTH_RESOURCE_DOCUMENTATION=https://docs.example.com
# AUTH_OAUTH_AUTHORIZATION_SERVERS=https://login.example.com/tenant

# Authorization server facade, enabled by the client ID: public clients
# register and sign in through this server, which relays to the issuer as
# this pre-registered client. An empty secret makes it a public client.
# Bare scopes get the prefix; resource is replaced, or dropped when empty.
# AUTH_OAUTH_FACADE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AUTH_OAUTH_FACADE_CLIENT_SECRET=replace-with-the-client-secret
# AUTH_OAUTH_FACADE_SCOPE_PREFIX=api://my-api
# AUTH_OAUTH_FACADE_UPSTREAM_RESOURCE=

# ── mTLS (AUTH_MODE=mtls) ────────────────────────────────────
# Common names, or distinguished names when an entry contains '=', written
# as pkix.Name.String renders them, escapes included; separated by ';'.
# AUTH_MTLS_ALLOWED_SUBJECTS=client.example;CN=admin,O=corp

# Base64 SHA-256 digests of the SubjectPublicKeyInfo, padded or not,
# standard or URL alphabet.
# AUTH_MTLS_SPKI_PINS=47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=

# ── Provider examples ────────────────────────────────────────
#
# Microsoft Entra ID:
#   AUTH_OAUTH_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
#   AUTH_OAUTH_AUDIENCE=api://your-app-id
#
# Keycloak:
#   AUTH_OAUTH_ISSUER=https://keycloak.example.com/realms/your-realm
#   AUTH_OAUTH_AUDIENCE=your-client-id
#
# Okta:
#   AUTH_OAUTH_ISSUER=https://your-org.okta.com/oauth2/default
#   AUTH_OAUTH_AUDIENCE=api://default
#
# Auth0 (the issuer keeps its trailing slash):
#   AUTH_OAUTH_ISSUER=https://your-tenant.auth0.com/
#   AUTH_OAUTH_AUDIENCE=https://your-api.example.com
#
# Google publishes its keys on another origin, so name them:
#   AUTH_OAUTH_ISSUER=https://accounts.google.com
#   AUTH_OAUTH_AUDIENCE=your-client-id.apps.googleusercontent.com
#   AUTH_OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
