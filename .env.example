# ── go-authware Configuration ─────────────────────────────────
# Reference values for ConfigFromEnv. Every variable is optional unless
# noted; modes are inferred from non-empty fields when AUTH_MODE is unset.

# ── Mode ─────────────────────────────────────────────────────
# none | bearer | apikey | oauth | mtls
AUTH_MODE=oauth

# ── General ──────────────────────────────────────────────────
# Realm advertised in WWW-Authenticate (default: restricted)
# AUTH_REALM=restricted

# ── Bearer Token ─────────────────────────────────────────────
# AUTH_BEARER_TOKEN=my-secret-token

# ── API Key ──────────────────────────────────────────────────
# AUTH_API_KEY=my-api-key
# AUTH_API_KEY_HEADER=X-Api-Key

# ── OAuth / JWT ──────────────────────────────────────────────
AUTH_OAUTH_ISSUER=https://accounts.google.com
AUTH_OAUTH_AUDIENCE=my-app

# AUTH_OAUTH_JWKS_URL is auto-discovered via OIDC if empty.
# AUTH_OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Testing only — use JWKS in production.
# AUTH_OAUTH_HMAC_SECRET=my-hmac-secret

# Required scopes for every accepted token (comma-separated).
# AUTH_OAUTH_REQUIRED_SCOPES=read,write

# OAuth proxy (MCP 2025-11-25 DCR shim).
# AUTH_OAUTH_CLIENT_ID=my-app-client-id
# AUTH_OAUTH_CLIENT_SECRET=my-app-client-secret

# RFC 9728 Protected Resource Metadata.
# AUTH_OAUTH_RESOURCE=https://api.example.com
# AUTH_OAUTH_RESOURCE_DOCUMENTATION=https://docs.example.com
# AUTH_OAUTH_RESOURCE_NAME=My API
# AUTH_OAUTH_AUTHORIZATION_SERVERS=https://accounts.google.com

# ── mTLS (server) ────────────────────────────────────────────
# Comma-separated allowed certificate Common Names.
# AUTH_MTLS_ALLOWED_SUBJECTS=client.example,client.partner

# Comma-separated base64-encoded SHA-256 SubjectPublicKeyInfo pins.
# AUTH_MTLS_SPKI_PINS=BASE64SHA256PIN==

# ── Hardening ────────────────────────────────────────────────
# Inbound body size cap (bytes, 0 disables).
# AUTH_SECURE_MAX_BYTES=1048576

# Strict-Transport-Security.
# AUTH_SECURE_HSTS_MAX_AGE=31536000
# AUTH_SECURE_HSTS_SUBS=true
# AUTH_SECURE_HSTS_PRELOAD=true

# Static security headers.
# AUTH_SECURE_CSP=default-src 'self'
# AUTH_SECURE_FRAME_OPTIONS=DENY
# AUTH_SECURE_NOSNIFF=true
# AUTH_SECURE_REFERRER_POLICY=no-referrer
# AUTH_SECURE_PERMISSIONS_POLICY=geolocation=()
# AUTH_SECURE_XSS_PROTECTION=0

# CSRF (cross-origin) trusted origins (comma-separated).
# AUTH_SECURE_CSRF_TRUSTED=https://app.example,https://admin.example

# ── Provider examples ────────────────────────────────────────
#
# Google:
#   AUTH_OAUTH_ISSUER=https://accounts.google.com
#   AUTH_OAUTH_AUDIENCE=your-client-id.apps.googleusercontent.com
#
# Auth0:
#   AUTH_OAUTH_ISSUER=https://your-tenant.auth0.com/
#   AUTH_OAUTH_AUDIENCE=https://your-api.example.com
#
# Keycloak:
#   AUTH_OAUTH_ISSUER=https://keycloak.example.com/realms/your-realm
#   AUTH_OAUTH_AUDIENCE=your-client-id
#
# Azure AD:
#   AUTH_OAUTH_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
#   AUTH_OAUTH_AUDIENCE=api://your-app-id
#
# Okta:
#   AUTH_OAUTH_ISSUER=https://your-org.okta.com/oauth2/default
#   AUTH_OAUTH_AUDIENCE=api://default
#
# Anthropic (MCP):
#   AUTH_OAUTH_ISSUER=https://auth.anthropic.com
#   AUTH_OAUTH_AUDIENCE=your-mcp-server
